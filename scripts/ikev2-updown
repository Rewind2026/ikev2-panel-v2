#!/bin/bash
# 由 swanctl 在 SA up/down 时调用
# 设计见 docs/design.md §9.2.1
#
# 环境变量（swanctl 提供）：
#   PLUTO_MY_ID         = 服务器 ID
#   PLUTO_PEER_ID       = 客户端 eap_id（swanctl 5.9+ 是 "CN=alice" 形式，需剥掉 CN=）
#   PLUTO_PEER_SOURCEIP = 客户端虚拟 IP
#   PLUTO_CONNECTION    = 连接名
#   PLUTO_VERB          = up | down
#
# v2.85-PR7 关键改动：family 感知 + IPv6 限速（flower classifier）
#   - v2 默认 IKEV2_IPV6_ONLY=true → family=ipv6 → 走 flower path
#   - 双栈 IKEV2_FAMILY=dual → 同时创建 v4(u32) + v6(flower) filter，共享 class ID
#   - family 注入：swanctl 不传业务环境变量 → 必须 source /etc/ikev2-panel/family.env
#
# 关键修订：
#   - Class ID 持久化到文件，避免并发冲突
#   - down 时只删该用户的 class，不删根 qdisc
#   - 根 qdisc 只建一次
set -e

LIMIT_DIR="/var/lib/ikev2-panel/limits"
CLASS_DIR="/var/lib/ikev2-panel/classids"
OUT_IF="${IKEV2_OUT_IF:-eth0}"

# v2.85-PR7:从文件注入 family（swanctl 不传业务环境变量）
#   /run/ikev2-panel/family.env 由 entrypoint.sh 在启动时生成
#   v2.86-PR11 后改放 /run/(root filesystem 只读),老位置 /etc/ikev2-panel/
#   作为 fallback 兼容旧版本镜像。
#   格式：FAMILY=ipv4|ipv6|dual
if [ -f /run/ikev2-panel/family.env ]; then
  # shellcheck disable=SC1091
  source /run/ikev2-panel/family.env
elif [ -f /etc/ikev2-panel/family.env ]; then
  # shellcheck disable=SC1091
  source /etc/ikev2-panel/family.env
fi
FAMILY="${FAMILY:-ipv4}"  # 默认 ipv4(向后兼容老 entrypoint 未生成 family.env 的场景)

# swanctl 5.9+ 的 PLUTO_PEER_ID 可能是 "CN=alice" 形式，需要剥掉
USERNAME="${PLUTO_PEER_ID#CN=}"
LIMIT_FILE="${LIMIT_DIR}/${USERNAME}"
CLASS_FILE="${CLASS_DIR}/${USERNAME}"

# 只在需要时建立根 qdisc（一次性，所有用户共用）
ensure_root_qdisc() {
  if ! tc qdisc show dev "$OUT_IF" 2>/dev/null | grep -q "qdisc htb"; then
    tc qdisc add dev "$OUT_IF" root handle 1: htb default 999 || true
    tc class add dev "$OUT_IF" parent 1: classid 1:999 htb \
      rate 1000mbit ceil 1000mbit || true
  fi
}

# v2.85-PR7:检测内核是否支持 tc flower（IPv6 限速需要 4.1+）
# 注意：iproute2 在新版本里把每种 classifier 的 help 拆开了，
# `tc filter help` 不再列出 flower,要 `tc filter add flower help` 才看得到。
flower_supported() {
  tc filter add flower help 2>&1 | grep -qi "src_ip\|ip_proto\|eth_type"
}

case "${PLUTO_VERB:-unknown}" in
  up)
    ensure_root_qdisc
    if [ -f "$LIMIT_FILE" ]; then
      LIMIT=$(cat "$LIMIT_FILE")
      if [ "${LIMIT}" -gt 0 ] 2>/dev/null; then
        mkdir -p "$CLASS_DIR"
        if [ -f "$CLASS_FILE" ]; then
          CLASS_ID=$(cat "$CLASS_FILE")
        else
          # 100-9099 范围，避免与 default class 999 冲突
          CLASS_ID=$((RANDOM % 9000 + 100))
          echo "$CLASS_ID" > "$CLASS_FILE"
        fi

        # ---- v2.85-PR7:按 family 选 filter 类型 ----
        # ipv4 → tc filter ... u32 match ip src ...
        # ipv6 → tc filter ... flower ip6_src ...(需要内核 4.1+)
        # dual  → 同时发两条 filter,共用同一个 class ID(HTB class 协议无关)
        #
        # 失败保护:IPv6 filter 添加失败时(内核太老)→ WARN 但不阻塞 SA 建立。
        # 这跟"先连接后限速"的设计原则一致。
        NEED_V4=0
        NEED_V6=0
        case "$FAMILY" in
          ipv4) NEED_V4=1 ;;
          ipv6) NEED_V6=1 ;;
          dual)  NEED_V4=1; NEED_V6=1 ;;
          *)     NEED_V4=1; echo "[updown] WARN: unknown FAMILY='${FAMILY}', falling back to ipv4" >&2 ;;
        esac

        # IPv4 路径(沿用 u32:u32 在所有内核上都支持)
        if [ "$NEED_V4" = "1" ]; then
          tc class add dev "$OUT_IF" parent 1: classid 1:${CLASS_ID} htb \
            rate "${LIMIT}mbit" ceil "${LIMIT}mbit" 2>/dev/null || true
          tc filter add dev "$OUT_IF" parent 1: protocol ip prio 1 u32 \
            match ip src "${PLUTO_PEER_SOURCEIP}" flowid 1:${CLASS_ID} 2>/dev/null || true
        fi

        # IPv6 路径(v2.85-PR7 新增:tc flower,Linux 4.1+)
        # 关键:flower classifier 用 src_ip(tc 自动按 IP 字面量判断 v4/v6)
        # 配合 protocol ipv6 让内核只在 IPv6 包上评估
        if [ "$NEED_V6" = "1" ]; then
          if flower_supported; then
            # dual 模式下:如果上一步 ipv4 分支没建 class(其实会建,因为 NEED_V4=1),这里 class add
            # 用 || true 保证幂等(同一 classid 重复 add 会失败,符合预期)
            if [ "$FAMILY" != "dual" ]; then
              tc class add dev "$OUT_IF" parent 1: classid 1:${CLASS_ID} htb \
                rate "${LIMIT}mbit" ceil "${LIMIT}mbit" 2>/dev/null || true
            fi
            tc filter add dev "$OUT_IF" parent 1: protocol ipv6 prio 1 flower \
              src_ip "${PLUTO_PEER_SOURCEIP}" flowid 1:${CLASS_ID} 2>/dev/null || true
          else
            echo "[updown] WARN: kernel lacks 'tc flower' support, IPv6 rate limit DISABLED for user ${USERNAME}" >&2
          fi
        fi

        echo "[updown] Applied ${LIMIT}Mbps (family=${FAMILY}) for user ${USERNAME} (VIP ${PLUTO_PEER_SOURCEIP}, class ${CLASS_ID})"
      fi
    fi
    ;;
  down)
    # v2.85-PR7:按 family 删对应 protocol 的 filter(class ID 跨 family 共享,所以只删一次)
    # 关键:先删 filter 再删 class(避免 "HTB class in use")
    if [ -f "$CLASS_FILE" ]; then
      CLASS_ID=$(cat "$CLASS_FILE")
      case "$FAMILY" in
        ipv4)
          tc filter del dev "$OUT_IF" parent 1: protocol ip prio 1 2>/dev/null || true
          tc class del dev "$OUT_IF" classid 1:${CLASS_ID} 2>/dev/null || true
          ;;
        ipv6)
          tc filter del dev "$OUT_IF" parent 1: protocol ipv6 prio 1 2>/dev/null || true
          tc class del dev "$OUT_IF" classid 1:${CLASS_ID} 2>/dev/null || true
          ;;
        dual)
          # dual:先删 2 个 filter,再删 1 个 class(共享)
          tc filter del dev "$OUT_IF" parent 1: protocol ip prio 1 2>/dev/null || true
          tc filter del dev "$OUT_IF" parent 1: protocol ipv6 prio 1 2>/dev/null || true
          tc class del dev "$OUT_IF" classid 1:${CLASS_ID} 2>/dev/null || true
          ;;
        *)
          tc filter del dev "$OUT_IF" parent 1: protocol ip prio 1 2>/dev/null || true
          tc class del dev "$OUT_IF" classid 1:${CLASS_ID} 2>/dev/null || true
          echo "[updown] WARN: unknown FAMILY='${FAMILY}' on down, fell back to ipv4" >&2
          ;;
      esac
      rm -f "$CLASS_FILE"
      echo "[updown] Removed class ${CLASS_ID} (family=${FAMILY}) for user ${USERNAME}"
    fi
    # 注意：不要 tc qdisc del root！否则其他用户的限速也失效
    ;;
esac
