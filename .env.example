# 容器内环境变量样例（v2.79：所有字段都可以不传）

# ============= 镜像版本(v2.85-PR1)=============
# 与 docker-compose.yml 的 image tag + Dockerfile 的 PANEL_VERSION ARG 同步。
# 升级时改这一处就行(改完 docker compose build 重新拉/编镜像)。
# 不传默认 v2.85。
# PANEL_TAG=v2.85
#
# 部署原则（v2-79 自动探测链）：
#   - 唯一必填：IKEV2_SERVER_CN（证书 CN 需要）
#   - LE 模式额外必填：IKEV2_DOMAIN + Ali_Key + Ali_Secret
#   - 其他字段全部可选；不传就由 entrypoint.sh §0 自动探测：
#       * IKEV2_OUT_IF      → 从 `ip -4 route show default` 取
#       * IKEV2_SERVER_ADDR_V6 → 从 /proc/net/if_inet6 取 2000::/3 段
#       * IKEV2_SERVER_ADDR_V4 → 从 OUT_IF 上的非 RFC1918 地址取
#       * IKEV2_VPN_SUBNET   → 扫描宿主 LAN 段，自动选不冲突的 10.x.0.0/24
#       * IKEV2_NETWORK_MODE → auto：宿主有公网 IP 选 host，否则 bridge

# ============= 持久化目录 =============
IKEV2_DATA_DIR=/data

# ============= HTTPS 监听地址 =============
IKEV2_LISTEN_ADDR=0.0.0.0:8443

# ============= 日志 =============
IKEV2_LOG_LEVEL=info
IKEV2_LOG_FORMAT=text

# ============= 服务器身份（v2-79 唯一必填项）=============
# 证书 CN + mobileconfig RemoteIdentifier 都用这个
# 必须是域名（不是 IP），因为 mobileconfig 的 RemoteIdentifier 必须是字符串主机名
IKEV2_SERVER_CN=vpn.example.com

# ============= 网络模式（v2-79 全部可选）=============
# 公网 IPv6（推荐；不填就自动从网卡取 2000::/3 段）
# IKEV2_SERVER_ADDR_V6=2408:832e:8a5:1000:be24:11ff:fefb:1bb
# 公网 IPv4（双栈模式才需要；不填就自动从网卡取）
# IKEV2_SERVER_ADDR_V4=
# IPv6-only 模式（true 推荐；false 表示双栈）
IKEV2_IPV6_ONLY=true
# 出口网卡（host 网络下必须用宿主真实网卡名；不填就自动探测）
# IKEV2_OUT_IF=ens18

# ============= VPN 网络（v2-79 新增）=============
# 网络模式：auto | host | bridge | ipvlan
# auto：自动选（推荐）
IKEV2_NETWORK_MODE=auto

# VPN 内部虚拟 IP 段：auto | 10.10.0.0/24 | ...
# auto 模式下扫描宿主 LAN 段，自动选不冲突的段
IKEV2_VPN_SUBNET=auto

# ============= 证书模式 =============
#   - self-signed  (默认): 自签 CA + 服务器证书,浏览器会报不安全(mobileconfig 用户已通过内嵌 CA 信任)
#   - letsencrypt:         Let's Encrypt 自动签发,浏览器 0 警告;需要公网域名 + 阿里云 DNS API 凭证
#
# v2-83:默认仍是 self-signed(不会破坏现有 mobileconfig 客户端的根 CA 信任链)。
#       切到 letsencrypt 是 **opt-in**:所有 mobileconfig 客户端的根 CA 信任会失效,
#       升级后必须重新分发 mobileconfig 才能让客户端继续信任 LE 证书。
#
# 启用 LE 步骤:
#   1. 改 IKEV2_CERT_MODE=letsencrypt
#   2. 填 IKEV2_DOMAIN (你的域名,解析到这台机器的公网 IP)
#   3. 填阿里云凭证(下方 # ============= 阿里云凭证 ============= 段),
#      推荐在面板 UI 里填,不用改 .env
#   4. 重启容器:docker compose restart
#   5. (重要!)重新生成所有 mobileconfig 分发给客户端
IKEV2_CERT_MODE=self-signed
# IKEV2_DOMAIN=vpn.example.com
# IKEV2_ACME_EMAIL=you@example.com
# IKEV2_ACME_WEBROOT=/var/www/acme

# ============= 阿里云凭证 (v2-83 统一) =============
# 用途:
#   1. Let's Encrypt DNS-01 签发 (LE 模式下必需)
#   2. DDNS 自动同步 (v2-82+ 可选,IPv6-only + 动态公网 v6 时强烈推荐)
#
# 推荐:在面板 "阿里云 API 凭证" 卡片填(写 /data/panel-state/aliyun.creds),
#      不用改这个文件 → 重启容器即可生效。
#
# env 优先级链 (高 → 低):
#   1. /data/panel-state/aliyun.creds   (面板 UI 填的)
#   2. IKEV2_ALIYUN_KEY_ID              (v2-83 统一命名,推荐)
#   3. ALIYUN_ACCESS_KEY_ID             (v2-82 legacy DDNS)
#   4. Ali_Key                          (acme.sh 命名,legacy)
#
# 阿里云 RAM 最小权限策略(给 AccessKey 对应 RAM 用户):
#   {
#     "Version": "1",
#     "Statement": [{
#       "Effect": "Allow",
#       "Action": [
#         "alidns:DescribeDomainRecords",
#         "alidns:UpdateDomainRecord"
#       ],
#       "Resource": "acs:alidns:*:*:domain/example.com"
#     }]
#   }

# v2-83 推荐(unified naming):
# IKEV2_ALIYUN_KEY_ID=
# IKEV2_ALIYUN_KEY_SECRET=
# v2-82 legacy (DDNS):
# ALIYUN_ACCESS_KEY_ID=
# ALIYUN_ACCESS_KEY_SECRET=
# acme.sh 原生 (legacy):
# Ali_Key=
# Ali_Secret=

# ============= 用户密码 =============
IKEV2_DEFAULT_USER_PASSWORD_LEN=12

# ============= Session =============
IKEV2_SESSION_TTL=24h

# ============= DDNS (v2-82 新增) =============
# 适用场景:VPS 公网 IPv6 动态分配(家用墙 / 部分云厂商),DDNS 把域名
# 解析记录跟着变。证书本身跟 IP 无关(SAN 只放域名),所以不需要重签。
#
# 凭证:见上方 # ============= 阿里云凭证 ============= 段(v2-83 统一凭证)
#
# 总开关(运行时也可由面板 UI 切换,状态写到 /etc/ikev2/ddns.conf):
#   - IKEV2_DDNS_ENABLED=true   启动同步
#   - IKEV2_DDNS_ENABLED=false  关闭(默认)
#
# 主域名(完整域名 = ALIYUN_RR + "." + ALIYUN_DOMAIN)
# ALIYUN_DOMAIN=example.com
# ALIYUN_RR=vpn

# ============= 面板时间显示时区 (v2.85 新增) =============
# 影响范围:
#   - 面板表格列(用户创建时间 / 最后登录 / 过期时间)
#   - DDNS 最近同步时间
#   - mobileconfig PayloadDescription 时间
# 不影响:
#   - 容器系统 TZ(entrypoint 仍按 UTC 跑 cron / acme.sh)
#   - 证书有效期(由 CA 决定)
#
# IANA TZ 名称: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# 常用值:
#   UTC                  (默认)
#   Asia/Shanghai        (中国大陆)
#   Asia/Hong_Kong       (香港)
#   Asia/Tokyo           (日本)
#   America/New_York     (美东)
#   Europe/London        (英国)
#   Europe/Berlin        (中欧)
IKEV2_DISPLAY_TIMEZONE=UTC
