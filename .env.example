# 容器内环境变量样例。除 IKEV2_SERVER_CN 外全部可以不传。

# ============= 镜像版本(v2.85-PR1)=============
# 与 docker-compose.yml 的 image tag + Dockerfile 的 PANEL_VERSION ARG 同步。
# 升级时改这一处就行(改完 docker compose build 重新拉/编镜像)。
# 不传默认 v2.85。
# PANEL_TAG=v2.85
#
# 部署原则（entrypoint.sh §0 自动探测链，详见 docs/architecture.md §10）：
#   - 唯一必填：IKEV2_SERVER_CN（证书 CN + mobileconfig RemoteIdentifier 都用它）
#   - LE 模式额外必填：IKEV2_DOMAIN + 阿里云凭证
#   - 其他字段全部可选；不传就由 entrypoint.sh §0 自动探测：
#       * IKEV2_OUT_IF         → 从 `ip -4 route show default` 取
#       * IKEV2_SERVER_ADDR_V6 → 从 /proc/net/if_inet6 取 2000::/3 段
#       * IKEV2_SERVER_ADDR_V4 → 从 OUT_IF 上的非 RFC1918 地址取
#       * IKEV2_VPN_SUBNET     → 扫描宿主 LAN 段，自动选不冲突的 10.x.0.0/24

# ============= 持久化目录 =============
IKEV2_DATA_DIR=/data

# ============= HTTPS 监听地址 =============
IKEV2_LISTEN_ADDR=0.0.0.0:8443

# ============= 日志 =============
IKEV2_LOG_LEVEL=info
IKEV2_LOG_FORMAT=text

# ============= 服务器身份（唯一必填项）=============
# 证书 CN + mobileconfig RemoteIdentifier 都用这个
# 必须是域名（不是 IP），因为 mobileconfig 的 RemoteIdentifier 必须是字符串主机名
IKEV2_SERVER_CN=vpn.example.com

# ============= 网络模式（v2.86-PR20 扩展）=============
# 三选一: host(默认) | macvlan | ipvlan
#
# host(默认,老用户什么都不用改)
#   容器与宿主共享 network namespace,直占宿主 UDP 500/4500 + TCP 8443。
#   仍需要公网 IPv6 直绑宿主网卡、且完全不做端口映射时用这个。
#
# macvlan
#   容器独占一个 MAC,直挂物理二层网络。500/4500 绑在**容器自己的 IP** 上,
#   因此宿主上 500/4500/8443 已被别的服务占用时也能跑。
#   代价:宿主与容器被内核隔离(宿主 ping 不到容器,需建 macvlan shim 才能通)。
#   前置条件:Linux only、kernel 3.9+、非 rootless;
#             部分云厂商 / OpenVZ 限制额外 MAC,表现为容器能起但收不到 ARP/RA。
#
# ipvlan
#   同 macvlan,但**共享宿主网卡的 MAC**(不消耗额外 MAC 地址,云环境更友好)。
#   代价:共享 MAC 在部分虚拟交换环境下高并发可能间歇丢包;
#         若出现该现象,改用 macvlan。
#   前置条件:Linux kernel 4.2+、非 rootless、默认 ipvlan_mode=l2。
#
# 切换方式:**换 compose 文件**（三个模式 = 三个独立完整的文件,不是 override）
#   host     docker compose up -d                                # 读 docker-compose.yml
#   macvlan  docker compose -f docker-compose.macvlan.yml up -d
#   ipvlan   docker compose -f docker-compose.ipvlan.yml up -d
#   或 ./scripts/up.sh   # 读下面的 IKEV2_NETWORK_MODE 自动选文件(还会建 ./logs 目录)
#
# ⚠️ 每份 compose 文件里 IKEV2_NETWORK_MODE 是**硬编码**的,`.env` 里写什么都不影响它
#    —— 网络由**文件**决定,这个变量只用于 entrypoint 内部的行为分支
#    (DDoS 链 / 转发持久化 / SLAAC 复核)。要换模式就换文件,改这个变量没用。
# ⚠️ 换模式必须重建容器:`docker compose -f <新文件> down` 再 `up -d`。
#
# 下面这行只是给 ./scripts/up.sh 用来选文件的,**不决定**容器的网络模式。
# IKEV2_NETWORK_MODE=host

# ---- 以下仅 macvlan / ipvlan 需要（L2 独立 IP 模式）----
# 宿主父接口名:macvlan/ipvlan 虚拟网卡挂在它上面。
# 查看方式:ip -br link   （不能填 lo）
# IKEV2_L2_PARENT=eth0

# 宿主所在的 IPv4 子网(CIDR)。**只支持 IPv4**。
# 为什么不给 IPv6 配子网:配了 Docker IPAM 会接管 IPv6 并默认分配 ULA(fd00::/8),
# 公网不可达。本项目的 IPv6 走「上游路由器发 RA → 容器 SLAAC 自动获取 GUA」。
# 所需配置 L2 compose 文件已写好,不需要在这里设置:
#   - networks 段 enable_ipv6: true          (否则 disable_ipv6=1,收不到 RA)
#   - service 段 sysctls 三条                 (v4/v6 forwarding + default.accept_ra=2)
# 容器内 /proc/sys 是 ro,entrypoint 事后改不了,必须在建容器时由 Docker 注入。
# 前缀需在 1-30 之间(/31 /32 没有网关语义)。
# IKEV2_L2_SUBNET=203.0.113.0/24

# 上面子网的宿主网关(容器经它出网)。必须落在 IKEV2_L2_SUBNET 内。
# 查看方式:ip -4 route show default
# IKEV2_L2_GATEWAY=203.0.113.1

# macvlan 专属。bridge(默认,推荐) | private | vepa
# passthru 与 IPAM 互斥(拿不到地址),本项目已禁用。
# IKEV2_MACVLAN_MODE=bridge

# ipvlan 专属。l2(默认,强烈推荐) | l3 | l3s
# l3 / l3s 会丢弃广播与组播,IKEv2 多用户并发场景不友好。
# IKEV2_IPVLAN_MODE=l2

# ipvlan 专属。bridge(默认) | private | vepa
# IKEV2_IPVLAN_FLAG=bridge

# 共享网络的 external 开关（v2.97，默认 false）。
#
# false（默认）→ docker compose 自己建这条网络：不存在就建、已存在就复用。
#                **纯 compose 部署（Docker 管理器 / 1Panel 等）就用这个默认值。**
# true          → compose 只加入这条网络，不创建也不删除 —— 网络必须**已经存在**
#                （比如你自己用 docker network create 建的，或别的项目建的）。
#                ⚠️ true 会跳过 compose 的 label 校验；false 不跳过。
#
# ⚠️ 用 ./scripts/up.sh 启动时，本变量会被 up.sh **强制**为 true
#    （网络已由 up.sh 建好并逐项校验过），不用手填。
# IKEV2_L2_EXTERNAL=false

# ---- L2 模式的已知限制 ----
# 宿主 ↔ 容器被内核隔离（macvlan / ipvlan 共有）。需要直连调试时在宿主建 shim:
#   ip link add macvlan-shim link <父接口> type macvlan mode bridge
#   ip addr add <同子网另一个IP>/<前缀> dev macvlan-shim
#   ip link set macvlan-shim up
# 本项目的对外入口是公网 IP 上的 UDP 500/4500 与 TCP 8443,不依赖宿主回环,
# 所以这只是排障便利项,不是功能依赖。
#
# ============= 信任反代（v2.86-PR15 安全强化）=============
# 默认 ClientIP() 不信任 X-Forwarded-For / X-Real-IP header ——
# 否则攻击者可以伪造 "X-Forwarded-For: 127.0.0.1" 绕过登录 5 次失败锁定。
#
# **只有在前面挂了 NLB / Nginx / Caddy / Cloudflare 等反代时才设为 true**:
#   1) 反代配置里要保留/追加 X-Forwarded-For(每层用 "," 分隔追加客户端 IP)
#   2) 本环境变量告诉面板"我前面的反代是可信的,取 XFF 最左 IP 当真实客户端"
#   3) **必须**只让反代访问面板端口(防火墙 / 内网监听),否则仍可被绕过
#
# 不设 / 设为 false → 面板只用 RemoteAddr(RFC 7239 标准 "原始客户端" 不可伪造)
# IKEV2_TRUSTED_PROXY=false
#
# 公网 IPv6（推荐；不填就自动从网卡取 2000::/3 段）
# ⚠️ 语义是项目既有契约：**空 → 自动探测；非空 → 跳过探测直接作为 charon 的
#    local_addrs**。macvlan/ipvlan 模式下这是 SLAAC 失败时的兜底开关。
#    但它只让 charon 绑这个地址，**不会**把地址配到容器网关上——
#    如果 SLAAC 没拿到地址、这个值又填错，charon 会绑定失败。
# IKEV2_SERVER_ADDR_V6=2408:832e:8a5:1000:be24:11ff:fefb:1bb
# 公网 IPv4（双栈模式才需要；不填就自动从网卡取）
# IKEV2_SERVER_ADDR_V4=
# IPv6-only 模式（true 推荐；false 表示双栈）
IKEV2_IPV6_ONLY=true
# 出口网卡（不填就自动探测）
# ⚠️ 语义随网络模式变化（v2.86-PR20）：
#    host    → 宿主真实网卡名（ens18 / enp0s3 ...）
#    macvlan / ipvlan → **容器内**网卡名（通常 eth0）
#    非 host 模式下若沿用宿主网卡名，entrypoint 会 FATAL exit 14
#    （因为该名字在容器 netns 内不存在，nft 规则会静默失效）。
#    L2 模式最省事的做法是**留空让它自动探测**。
# IKEV2_OUT_IF=ens18

# ============= VPN 内部虚拟 IP 段 =============
# auto | 10.10.0.0/24 | ...
# auto 模式下扫描宿主 LAN 段，自动选不冲突的段
IKEV2_VPN_SUBNET=auto

# ============= 证书模式 =============
#   - self-signed  (默认): 自签 CA + 服务器证书,浏览器会报不安全(mobileconfig 用户已通过内嵌 CA 信任)
#   - letsencrypt:         Let's Encrypt 自动签发,浏览器 0 警告;需要公网域名 + 阿里云 DNS API 凭证
#
# v2-83:默认仍是 self-signed(不会破坏现有 mobileconfig 客户端的根 CA 信任链)。
#       切到 letsencrypt 是 **opt-in**:所有 mobileconfig 客户端的根 CA 信任会失效,
#       升级后必须重新分发 mobileconfig 才能让客户端继续信任 LE 证书。
#
# 启用 LE 步骤:
#   1. 改 IKEV2_CERT_MODE=letsencrypt
#   2. 填 IKEV2_DOMAIN (你的域名,解析到这台机器的公网 IP)
#   3. 填阿里云凭证(下方 # ============= 阿里云凭证 ============= 段),
#      推荐在面板 UI 里填,不用改 .env
#   4. 重启容器:docker compose restart
#   5. (重要!)重新生成所有 mobileconfig 分发给客户端
IKEV2_CERT_MODE=self-signed
# IKEV2_DOMAIN=vpn.example.com
# IKEV2_ACME_EMAIL=you@example.com
# IKEV2_ACME_WEBROOT=/var/www/acme

# ============= 阿里云凭证 (v2-83 统一) =============
# 用途:
#   1. Let's Encrypt DNS-01 签发 (LE 模式下必需)
#   2. DDNS 自动同步 (v2-82+ 可选,IPv6-only + 动态公网 v6 时强烈推荐)
#
# 推荐:在面板 "阿里云 API 凭证" 卡片填(写 /data/panel-state/aliyun.creds),
#      不用改这个文件。面板读的凭证是**每轮同步现读**,填完即时生效,无需重启。
#
# env 优先级链 (高 → 低):
#   1. /data/panel-state/aliyun.creds   (面板 UI 填的)
#   2. IKEV2_ALIYUN_KEY_ID              (v2-83 统一命名,推荐)
#   3. ALIYUN_ACCESS_KEY_ID             (v2-82 legacy DDNS)
#   4. Ali_Key                          (acme.sh 命名,legacy)
#
# 阿里云 RAM 最小权限策略(给 AccessKey 对应 RAM 用户):
#   {
#     "Version": "1",
#     "Statement": [{
#       "Effect": "Allow",
#       "Action": [
#         "alidns:DescribeDomainRecords",
#         "alidns:UpdateDomainRecord"
#       ],
#       "Resource": "acs:alidns:*:*:domain/example.com"
#     }]
#   }

# v2-83 推荐(unified naming):
# IKEV2_ALIYUN_KEY_ID=
# IKEV2_ALIYUN_KEY_SECRET=
# v2-82 legacy (DDNS):
# ALIYUN_ACCESS_KEY_ID=
# ALIYUN_ACCESS_KEY_SECRET=
# acme.sh 原生 (legacy):
# Ali_Key=
# Ali_Secret=

# ============= 用户密码 =============
IKEV2_DEFAULT_USER_PASSWORD_LEN=12

# ============= Session =============
IKEV2_SESSION_TTL=24h

# ============= DDNS (v2-82 新增) =============
# 适用场景:VPS 公网 IPv6 动态分配(家用墙 / 部分云厂商),DDNS 把域名
# 解析记录跟着变。证书本身跟 IP 无关(SAN 只放域名),所以不需要重签。
#
# 凭证:见上方 # ============= 阿里云凭证 ============= 段(v2-83 统一凭证)
#
# 总开关(运行时也可由面板 UI 切换,状态写到 /data/panel-state/ddns-runtime.conf)。
# 默认 true —— 首次启动后在面板首页填阿里云凭证 + 主域名 / RR 即可开箱即用,
# 不需要改这个文件再 restart。
#
#   - IKEV2_DDNS_ENABLED=true   启动同步(默认)
#   - IKEV2_DDNS_ENABLED=false  关闭
IKEV2_DDNS_ENABLED=true
#
# 主域名(完整域名 = ALIYUN_RR + "." + ALIYUN_DOMAIN)
# ALIYUN_DOMAIN=example.com
# ALIYUN_RR=vpn

# ============= 面板时间显示时区 (v2.85 新增) =============
# 影响范围:
#   - 面板表格列(用户创建时间 / 最后登录 / 过期时间)
#   - DDNS 最近同步时间
#   - mobileconfig PayloadDescription 时间
# 不影响:
#   - 容器系统 TZ(entrypoint 仍按 UTC 跑 cron / acme.sh)
#   - 证书有效期(由 CA 决定)
#
# IANA TZ 名称: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# 常用值:
#   UTC                  (默认)
#   Asia/Shanghai        (中国大陆)
#   Asia/Hong_Kong       (香港)
#   Asia/Tokyo           (日本)
#   America/New_York     (美东)
#   Europe/London        (英国)
#   Europe/Berlin        (中欧)
IKEV2_DISPLAY_TIMEZONE=UTC
